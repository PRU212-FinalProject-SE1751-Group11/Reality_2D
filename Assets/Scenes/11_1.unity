  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 136701419}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 781621a828cdf4943a605579961f5455, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogues:
  - name: Guy
    lines:
    - Ah.... It's so windy out here
    - And this lighter doesn't work
    condition: 7
    triggers: []
  - name: Guy
    lines:
    - ' Hey man! That lighter you holding, can i borrow it?'
    - Ah...That hits the spot.
    - You know what man, this was going to be my last cigarette.
    - I was going to retired from the force too.
    - After this last train ride, i'll go home and see my family.
    - 'Anyway, I see your face looks quite worried '
    - You know what, I saw a little girl passing by here a couple hours ago.
    - In her hand she held a bottle of medicine....In my experience, it was probably
      a sedative or something related
    - What did a child go through with something like that?
    - (Sigh........)
    condition: 3
    triggers:
    - condition: 4
      value: 1
